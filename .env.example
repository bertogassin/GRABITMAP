# GRABIT — production env (copy to .env and fill in)

# Required
ADMIN_KEY=change-me

# Optional first-owner email. If empty, Admin V2 creates a placeholder owner
# so the web server can start. Set both to take over that owner account.
RESEND_API_KEY=
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=

# Optional Telegram bot (group posts + DM; web works without it)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=0

# Database (default: data/votes.db)
DATABASE_URL=sqlite:data/votes.db

# HTTP port (default 3000)
PORT=3000

# Promotion price in euro cents (499 = 4.99 EUR)
PROMOTION_PRICE_MINOR=499

# Stripe (production payments for group promotion)
# Without STRIPE_SECRET_KEY mock payment is allowed only on localhost,
# or when ALLOW_MOCK_PROMOTION_PAYMENT=1 (dev only — never on production).
ALLOW_MOCK_PROMOTION_PAYMENT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://grabitmap.com

# Email auth (Resend)
GRABIT_MAIL_FROM=GRABIT <noreply@grabitmap.com>

# Bot translation (optional)
LIBRETRANSLATE_URL=

# Local HTTP dev only: set to 0 to allow session cookies without HTTPS
GRABIT_COOKIE_SECURE=1
